rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Documentos Confidenciales de Identidad (Cédulas, Certificaciones Técnicas)
    match /mantech_docs/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'admin@mantech.com');
    }

    // Reportes de Inspección, Fotos de Activos y Evidencias de Mantenimiento
    match /reports/{requestId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /assets/{assetId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Fallback seguro: Resto de rutas solo accesibles por administradores
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'admin@mantech.com';
    }
  }
}
