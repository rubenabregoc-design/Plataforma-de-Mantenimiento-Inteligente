rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@mantech.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Configuración Pública (Landing Page y constantes de plataforma)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Perfiles de Usuarios (Blindaje contra auto-elevación a admin y auto-asignación de suscripciones)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin');
      allow update: if isOwner(userId) ? (
        isAdmin() || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'subscription', 'plan', 'subscriptionStatus'])
        )
      ) : isAdmin();
      allow delete: if isAdmin();
    }

    // Perfiles Técnicos (Blindaje de billetera y plan técnico)
    match /technicians/{techId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['wallet', 'plan']) || isAdmin()))
      );
      allow delete: if isAdmin();
    }

    // Solicitudes de Servicio (Requests)
    match /requests/{requestId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Mensajes de Chat
    match /messages/{messageId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Notificaciones
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // Videollamadas WebRTC (Señalización temporal)
    match /calls/{callId} {
      allow read, write: if isSignedIn();
      match /{subCollection=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Activos de Clientes
    match /assets/{assetId} {
      allow read, write: if isSignedIn();
    }

    // Recordatorios de Mantenimiento
    match /reminders/{reminderId} {
      allow read, write: if isSignedIn();
    }

    // Agenda de Citas / Mantenimiento
    match /agenda/{agendaId} {
      allow read, write: if isSignedIn();
    }

    // Señales PTT y Radio en tiempo real (Volátiles)
    match /radio_signals/{signalId} {
      allow read, write: if isSignedIn();
    }

    // Foro y Comunidad Técnica
    match /forum_topics/{topicId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /forum_replies/{replyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Inventario
    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    // Tickets de Soporte
    match /support_tickets/{ticketId} {
      allow create: if true; // Formularios de contacto web
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userEmail == request.auth.token.email);
    }

    // Logs de Auditoría
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Inmutables
    }

    // Fallback seguro
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
